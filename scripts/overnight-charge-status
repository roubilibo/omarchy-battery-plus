#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-${HOME:-/home/roubilibo/.config}}
config="$config_home/omarchy/overnight-charge.conf"
enabled=0

if [ -r "$config" ]; then
  value=$(sed -n 's/^enabled=//p' "$config" | sed -n '1p')
  [ "$value" = "1" ] && enabled=1
fi

for battery in /sys/class/power_supply/BAT*; do
  [ -r "$battery/charge_types" ] || continue
  printf 'supported\t1\n'
  printf 'enabled\t%s\n' "$enabled"
  printf 'day\t06:00-18:00\n'
  printf 'night\t18:00-06:00\n'
  exit 0
done

printf 'supported\t0\n'
printf 'enabled\t%s\n' "$enabled"
