#!/bin/sh
set -eu

path=""
for candidate in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode; do
  if [ -r "$candidate" ]; then
    path="$candidate"
    break
  fi
done

if [ -z "$path" ]; then
  echo "Lenovo conservation mode is not available on this system" >&2
  exit 1
fi

current=$(cat "$path")
case "$current" in
  0) next=1 ;;
  1) next=0 ;;
  *)
    echo "Unsupported conservation mode value: $current" >&2
    exit 1
    ;;
esac

# The kernel sysfs control is root-owned. Polkit provides the graphical
# authentication prompt when this is launched from the Omarchy panel.
printf '%s\n' "$next" | pkexec /usr/bin/tee "$path" >/dev/null
