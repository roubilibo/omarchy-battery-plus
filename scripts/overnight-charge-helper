#!/bin/sh
set -eu

config=${OVERNIGHT_CHARGE_CONFIG:-/home/roubilibo/.config/omarchy/overnight-charge.conf}

log() {
  printf '%s\n' "$*"
}

[ -r "$config" ] || {
  log "configuration missing path=$config action=skip"
  exit 0
}

enabled=$(sed -n 's/^enabled=//p' "$config" | sed -n '1p')
[ "$enabled" = "1" ] || {
  log "schedule disabled action=skip charge_type=unchanged"
  exit 0
}

hour=$(/usr/bin/date +%H)
case "$hour" in
  06|07|08|09|10|11|12|13|14|15|16|17) target=Standard; slot=day ;;
  *) target=Long_Life; slot=night ;;
esac

log "schedule enabled slot=$slot hour=$hour target=$target"

for battery in /sys/class/power_supply/BAT*; do
  path="$battery/charge_types"
  [ -r "$path" ] || continue

  available=$(cat "$path" | sed 's/\[//g; s/\]//g')
  if ! printf '%s\n' "$available" | grep -F -w -- "$target" >/dev/null; then
    log "charge_type unavailable battery=$battery target=$target available=$available"
    exit 1
  fi

  active=$(cat "$path" | sed -n 's/.*\[\([^]]*\)\].*/\1/p')
  if [ "$active" = "$target" ]; then
    log "charge_type unchanged battery=$battery active=$active"
    exit 0
  fi

  printf '%s\n' "$target" > "$path"
  log "charge_type changed battery=$battery from=${active:-unknown} to=$target"
  exit 0
done

log "battery interface unavailable action=skip"
exit 0
