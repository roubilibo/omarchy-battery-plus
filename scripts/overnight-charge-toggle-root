#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || exit 1
[ "${1:-}" = "on" ] || {
  echo "Usage: $0 on" >&2
  exit 2
}

user=roubilibo
user_home=/home/$user
user_uid=$(id -u "$user")
user_gid=$(id -g "$user")

# Only allow the graphical user who requested the polkit action to enable this
# machine-wide behavior. The fixed account also matches the systemd unit.
[ "${PKEXEC_UID:-}" = "$user_uid" ] || exit 1

config_dir="$user_home/.config/omarchy"
config="$config_dir/overnight-charge.conf"
mkdir -p "$config_dir"
chown "$user_uid:$user_gid" "$config_dir"
chmod 700 "$config_dir"

umask 077
tmp=$(mktemp "$config_dir/.overnight-charge.conf.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM

printf 'enabled=1\nday_start=06:00\nday_end=18:00\n' > "$tmp"
chown "$user_uid:$user_gid" "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$config"
chown "$user_uid:$user_gid" "$config"
chmod 600 "$config"

# Apply the current time slot immediately; the timer still covers future
# transitions and the path unit covers later configuration changes.
/usr/local/libexec/omarchy-overnight-charge

trap - EXIT HUP INT TERM
